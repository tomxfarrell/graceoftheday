      "position": "right",
      "widthRatio": 0.57,
      "top": 1082,
      "tag": "span",
      "kind": "statement"
     },
     {
      "text": "“I have come to set the earth on fire, and how I wish it were already blazing!”",
      "words": 17,
      "chars": 79,
      "lines": 2,
      "size": 30,
      "vw": 2.1,
      "font": "Cormorant Garamond",
      "weight": 500,
      "tracking": 0,

      "position": "right",
      "widthRatio": 0.57,
      "top": 1274,
      "tag": "span",
      "kind": "statement"
     },
     {
      "text": "“You also must be prepared, for at an hour you do not expect, the Son of Man will come.”",
      "words": 19,
      "chars": 88,
      "lines": 2,
      "size": 30,
      "vw": 2.1,
      "font": "Cormorant Garamond",
      "weight": 500,
      "tracking": 0,
      "leading": 1.3,
      "upper": false,
      "italic": true,
      "mono": false,
